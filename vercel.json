{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/work",
      "destination": "/index.html"
    },
    {
      "source": "/nexus-preview",
      "destination": "/nexus-preview.png"
    },
    {
      "source": "/nexus-preview-scrolled-mid",
      "destination": "/nexus-preview-scrolled-mid.png"
    },
    {
      "source": "/nexus-preview-scrolled-deep",
      "destination": "/nexus-preview-scrolled-deep.png"
    }
  ]
}
